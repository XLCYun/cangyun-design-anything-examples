{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Design Anything 风格示例",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "description", "author", "license", "images"],
  "properties": {
    "$schema": { "type": "string" },
    "title": { "type": "string", "minLength": 1 },
    "style": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "author": { "type": "string", "minLength": 1 },
    "license": { "type": "string", "minLength": 1 },
    "images": {
      "description": "图片按展示顺序排列，第一张作为封面。",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "caption"],
        "properties": {
          "file": {
            "type": "string",
            "pattern": "^images/[a-z0-9][a-z0-9_-]*[.](webp|png|jpe?g)$"
          },
          "caption": { "type": "string", "minLength": 1 }
        }
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url"],
        "properties": {
          "url": { "type": "string", "format": "uri", "pattern": "^https?://" },
          "title": { "type": "string", "minLength": 1 },
          "credit": { "type": "string", "minLength": 1 },
          "license": { "type": "string", "minLength": 1 }
        }
      }
    },
    "prompt": { "type": "string", "minLength": 1 },
    "sourceFiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^source/([a-z0-9][a-z0-9_-]*/)*[a-z0-9][a-z0-9._-]*$"
      }
    }
  }
}
